# Только сервер. Заполненный .env не публикуется.
ANYMODEL_API_KEY=
ANYMODEL_MODEL=ag/gemini-2.5-flash
ANYMODEL_JSON_MODE=off
ANYMODEL_IMAGE_MODEL=am/flux.2-klein-4b
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DAILY_REQUEST_LIMIT=20
DAILY_UPSTREAM_LIMIT=30
PUBLIC_BURST_LIMIT=3
# Для устойчивых лимитов нужен постоянный диск и один экземпляр сервера.
DATA_DIR=./var
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Только после проверки тарифного плана Workers Free.
CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Отдельная текстовая модель Су-шефа; тот же серверный ключ AnyModel.
ANYMODEL_CHAT_MODEL=ds/deepseek-v4-flash
DAILY_CHAT_LIMIT=100

# Общий бюджет времени подбора, включая возможное исправление JSON (60–600 секунд).
SELECTION_TIMEOUT_SECONDS=300
