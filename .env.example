# Секреты задаются только на сервере. Не публиковать заполненный файл.
ANYMODEL_API_KEY=
ANYMODEL_MODEL=ag/gemini-2.5-flash
# Пароль владельца: минимум 16 символов. Не тот же пароль, что от GitHub.
APP_PASSWORD=
# Отдельная случайная строка: минимум 32 символа.
SESSION_SECRET=
PORT=3000
# В production обязателен реальный HTTPS-адрес приложения.
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
DAILY_REQUEST_LIMIT=20
DAILY_UPSTREAM_LIMIT=30
# Для устойчивых лимитов нужен постоянный диск. На временном диске хостинга
# счётчики сбросятся при замене/перезапуске экземпляра с потерей файлов.
DATA_DIR=./var
# Безопасный строгий JSON-режим включается после проверки поддержки маршрута.
ANYMODEL_JSON_MODE=off
